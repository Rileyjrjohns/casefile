# Copy to .env, which stays outside Git and Docker build contexts.
# Docker Compose, make serve, make eval-decisions-live and make record-decisions-jev read .env.
# Tests and offline evaluations do not load this file.

# Keep demo decisions until Jev is explicitly enabled.
CASEFILE_DECISIONS='{}'
# To enable Jev for priority and recommendations, replace the line above with:
# CASEFILE_DECISIONS='{"priority":"jev","recommendation":"jev"}'
# The risk score always uses the local model.

CASEFILE_JEV_URL=https://api.typesafe.ai/v1/systemone
CASEFILE_JEV_MODEL=jev-latest
CASEFILE_JEV_API_KEY=''
# Published Jev 1.13/1.14 rates in USD per million tokens, checked 2026-10-24.
# Source: https://docs.typesafe.ai/models (output tokens are free).
# Override if your provider, model or account uses a different price.
CASEFILE_JEV_INPUT_COST_PER_MILLION=0.042
CASEFILE_JEV_OUTPUT_COST_PER_MILLION=0

# Optional alternative: a Chat Completions-compatible typed-decision provider.
# Enable selected purposes with "llm" in CASEFILE_DECISIONS.
# For a Jev-only comparison: make eval-decisions-live DECISION_PROVIDERS="local jev"
# The default comparison selects both remote providers, regardless of routes.
CASEFILE_LLM_URL=
CASEFILE_LLM_MODEL=
CASEFILE_LLM_API_KEY=''
CASEFILE_LLM_INPUT_COST_PER_MILLION=
CASEFILE_LLM_OUTPUT_COST_PER_MILLION=
